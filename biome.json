{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/record-live-fixtures.ts",
      "scripts/demo-credit-footer.ts",
      "test/**",
      "*.ts",
      "*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "preset": "recommended"
      },
      "suspicious": {
        "noNestedPromises": "off"
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
